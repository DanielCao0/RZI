menuconfig RZI
	bool "RAK RZI SDK"
	help
	  Enable the RAK Zephyr Interface SDK. Individual RZI services are
	  selected below.

if RZI

# Shared foundations first: later services depend on these symbols.
rsource "Kconfig.storage"
rsource "Kconfig.boot"

# Radio and command services, then power.
rsource "Kconfig.lorawan"
rsource "Kconfig.lora"
rsource "Kconfig.at"
rsource "Kconfig.power"

endif
