menuconfig RZI
	bool "RAK RZI SDK"
	help
	  Enable the RAK Zephyr Interface SDK. Individual RZI services are
	  selected below.

if RZI

config RZI_LORAWAN
	bool "RZI LoRaWAN service"
	depends on FLASH
	help
	  Enable the backend-independent RZI LoRaWAN service API.

if RZI_LORAWAN

choice RZI_LORAWAN_BACKEND
	prompt "LoRaWAN backend"
	default RZI_LORAWAN_BACKEND_USP

config RZI_LORAWAN_BACKEND_USP
	bool "Semtech USP and LoRa Basics Modem"
	depends on !LORA && !LORAWAN
	select LORA_BASICS_MODEM_DRIVERS
	select USP
	select USP_LORA_BASICS_MODEM
	select USP_MAIN_THREAD
	select USP_THREADS_MUTEXES
	help
	  Use the Semtech USP and LoRa Basics Modem implementation. RZI owns
	  the modem; applications must not call Semtech APIs directly.

endchoice

config RZI_LORAWAN_EVENT_QUEUE_SIZE
	int "LoRaWAN event queue depth"
	depends on RZI_LORAWAN
	range 4 64
	default 8

endif # RZI_LORAWAN

config RZI_AT
	bool "RUI3-compatible AT command service (basic subset)"
	depends on RZI_LORAWAN
	select UART_INTERRUPT_DRIVEN
	help
	  Basic RAK RUI3-compatible AT command interface over UART. The
	  application passes the UART device to rzi_at_init(); the service
	  owns the UART and consumes the RZI LoRaWAN API. Implemented
	  subset: AT, ATZ, ATR, VER, DEVEUI, APPEUI, APPKEY, BAND, NJM
	  (OTAA only), NJS, CLASS (A only), CFM, CFS, JOIN, SEND and RECV.

config RZI_AT_NVM
	bool "Persist AT parameters in flash"
	depends on RZI_AT
	select SETTINGS
	select NVS
	select FLASH_MAP
	help
	  Persist the AT parameters (DEVEUI, APPEUI, APPKEY, BAND, CFM)
	  with the Zephyr settings subsystem, and enable ATR to restore
	  the devicetree defaults. The application selects the settings
	  backend itself (CONFIG_SETTINGS_NVS=y recommended); the backend
	  choice is a Kconfig choice symbol and cannot be selected here.
	  The storage area is board-defined: RZI uses the standard
	  "storage_partition" devicetree partition, or the partition
	  pointed to by the zephyr,settings-partition chosen node. RZI
	  never hardcodes flash addresses.

endif
