menuconfig RZI
	bool "RAK RZI SDK"
	help
	  Enable the RAK Zephyr Interface SDK. Individual RZI services are
	  selected below.

if RZI

config RZI_LORAWAN
	bool "RZI LoRaWAN service"
	depends on FLASH
	help
	  Enable the backend-independent RZI LoRaWAN service API.

if RZI_LORAWAN

choice RZI_LORAWAN_BACKEND
	prompt "LoRaWAN backend"
	default RZI_LORAWAN_BACKEND_USP

config RZI_LORAWAN_BACKEND_USP
	bool "Semtech USP and LoRa Basics Modem"
	depends on !LORA && !LORAWAN
	select LORA_BASICS_MODEM_DRIVERS
	select USP
	select USP_LORA_BASICS_MODEM
	select USP_MAIN_THREAD
	select USP_THREADS_MUTEXES
	help
	  Use the Semtech USP and LoRa Basics Modem implementation. RZI owns
	  the modem; applications must not call Semtech APIs directly.

config RZI_LORAWAN_BACKEND_TEST
	bool "In-process test backend"
	depends on ZTEST
	help
	  Select a backend supplied by a RZI unit-test application. Do not use
	  this option in production firmware.

endchoice

config RZI_LORAWAN_EVENT_QUEUE_SIZE
	int "LoRaWAN event queue depth"
	depends on RZI_LORAWAN
	range 4 64
	default 8

config RZI_LORAWAN_MAX_CALLBACKS
	int "Maximum LoRaWAN callback subscribers"
	depends on RZI_LORAWAN
	range 1 16
	default 4

config RZI_LORAWAN_DISPATCHER_STACK_SIZE
	int "LoRaWAN callback dispatcher stack size"
	depends on RZI_LORAWAN
	range 1024 8192
	default 2048

config RZI_LORAWAN_DISPATCHER_PRIORITY
	int "LoRaWAN callback dispatcher preemptive priority"
	depends on RZI_LORAWAN
	range 0 15
	default 10

endif # RZI_LORAWAN

config RZI_AT
	bool "RUI3-compatible AT command framework"
	select REBOOT
	help
	  Enable the transport-independent AT parser, command registry,
	  response formatter and execution thread. Command packages and
	  transports are selected independently below.

if RZI_AT

config RZI_AT_COMMAND_LORAWAN
	bool "LoRaWAN AT command package"
	depends on RZI_LORAWAN
	default n
	help
	  Enable the RUI3-compatible LoRaWAN command subset. This package is
	  a client of the public RZI LoRaWAN API.

config RZI_AT_TRANSPORT_UART
	bool "UART AT transport"
	depends on SERIAL
	select UART_INTERRUPT_DRIVEN
	default n
	help
	  Bind the AT framework to one application-selected interrupt UART.

config RZI_AT_MAX_COMMANDS
	int "Maximum registered AT commands"
	range 8 256
	default 32

config RZI_AT_MAX_EXTENSIONS
	int "Maximum AT command extensions"
	range 1 16
	default 4

config RZI_AT_LINE_MAX
	int "Maximum AT input line length"
	range 64 2048
	default 600

config RZI_AT_RX_BUFFER_SIZE
	int "AT receive ring buffer size"
	range 128 4096
	default 1024

config RZI_AT_TX_BUFFER_SIZE
	int "AT response formatting buffer size"
	range 128 2048
	default 640

config RZI_AT_THREAD_STACK_SIZE
	int "AT execution thread stack size"
	range 1024 8192
	default 2048

config RZI_AT_THREAD_PRIORITY
	int "AT execution thread preemptive priority"
	range 0 15
	default 14

config RZI_AT_PROCESS_INTERVAL_MS
	int "AT extension processing interval in milliseconds"
	range 1 1000
	default 20

config RZI_AT_ECHO
	bool "Echo AT input characters"
	default y
	help
	  Echo printable input and line editing characters using RUI3-style
	  terminal behavior. Disable this when the host performs local echo.

config RZI_AT_NVM
	bool "Persist LoRaWAN AT parameters in flash"
	depends on RZI_AT_COMMAND_LORAWAN
	select SETTINGS
	select NVS
	select FLASH_MAP
	help
	  Persist the AT parameters (DEVEUI, APPEUI, APPKEY, BAND, CFM)
	  with the Zephyr settings subsystem, and enable ATR to restore
	  the devicetree defaults. The application selects the settings
	  backend itself (CONFIG_SETTINGS_NVS=y recommended); the backend
	  choice is a Kconfig choice symbol and cannot be selected here.
	  The storage area is board-defined: RZI uses the standard
	  "storage_partition" devicetree partition, or the partition
	  pointed to by the zephyr,settings-partition chosen node. RZI
	  never hardcodes flash addresses.

endif # RZI_AT

endif
