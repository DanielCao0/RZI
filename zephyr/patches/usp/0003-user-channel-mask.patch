 #define downlink_dwell_time_ctx real_ctx.downlink_dwell_time_ctx
 
+static uint8_t smtc_real_user_channel_mask_size( const smtc_real_t* real )
+{
+    return ( real_const.const_number_of_tx_channel + 7 ) / 8;
+}
+
+smtc_real_status_t smtc_real_set_user_channel_mask( smtc_real_t* real, const uint8_t* mask, uint8_t mask_size )
+{
+    uint8_t nb_channels = real_const.const_number_of_tx_channel;
+    bool    any         = false;
+    bool    all         = true;
+
+    if( real_const.const_new_channel_req_supported )
+    {
+        return SMTC_REAL_STATUS_UNSUPPORTED_FEATURE;
+    }
+    if( mask_size == 0 )
+    {
+        real->user_channel_mask_set = false;
+        return SMTC_REAL_STATUS_OK;
+    }
+    if( ( mask == NULL ) || ( mask_size < smtc_real_user_channel_mask_size( real ) ) ||
+        ( mask_size > SMTC_REAL_USER_CHANNEL_MASK_SIZE ) )
+    {
+        return SMTC_REAL_STATUS_UNKNOWN_VALUE;
+    }
+    for( uint8_t i = 0; i < mask_size * 8; i++ )
+    {
+        bool enabled = SMTC_GET_BIT8( mask, i ) == CHANNEL_ENABLED;
+
+        if( i >= nb_channels )
+        {
+            if( enabled )
+            {
+                return SMTC_REAL_STATUS_UNKNOWN_VALUE;
+            }
+            continue;
+        }
+        any |= enabled;
+        all &= enabled;
+    }
+    if( !any )
+    {
+        return SMTC_REAL_STATUS_UNKNOWN_VALUE;
+    }
+    memset( real->user_channel_mask, 0, sizeof( real->user_channel_mask ) );
+    memcpy( real->user_channel_mask, mask, smtc_real_user_channel_mask_size( real ) );
+    real->user_channel_mask_set = !all;
+    return SMTC_REAL_STATUS_OK;
+}
+
+smtc_real_status_t smtc_real_get_user_channel_mask( smtc_real_t* real, uint8_t* mask, uint8_t mask_size )
+{
+    if( real_const.const_new_channel_req_supported )
+    {
+        return SMTC_REAL_STATUS_UNSUPPORTED_FEATURE;
+    }
+    if( ( mask == NULL ) || ( mask_size < smtc_real_user_channel_mask_size( real ) ) )
+    {
+        return SMTC_REAL_STATUS_UNKNOWN_VALUE;
+    }
+    memset( mask, 0, mask_size );
+    if( real->user_channel_mask_set )
+    {
+        memcpy( mask, real->user_channel_mask, smtc_real_user_channel_mask_size( real ) );
+    }
+    else
+    {
+        for( uint8_t i = 0; i < real_const.const_number_of_tx_channel; i++ )
+        {
+            SMTC_PUT_BIT8( mask, i, CHANNEL_ENABLED );
+        }
+    }
+    return SMTC_REAL_STATUS_OK;
+}
+
+void smtc_real_apply_user_channel_mask( smtc_real_t* real )
+{
+    uint8_t size = smtc_real_user_channel_mask_size( real );
+    bool    any  = false;
+
+    if( ( real->user_channel_mask_set == false ) || ( channel_index_enabled_ctx == NULL ) )
+    {
+        return;
+    }
+    for( uint8_t i = 0; i < size; i++ )
+    {
+        any |= ( channel_index_enabled_ctx[i] & real->user_channel_mask[i] ) != 0;
+    }
+    for( uint8_t i = 0; i < size; i++ )
+    {
+        channel_index_enabled_ctx[i] =
+            any ? ( channel_index_enabled_ctx[i] & real->user_channel_mask[i] ) : real->user_channel_mask[i];
+    }
+}
