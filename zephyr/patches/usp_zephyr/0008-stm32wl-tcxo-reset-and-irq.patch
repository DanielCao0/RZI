+/* Radio reset clears the VDDTCXO regulator. Park the CPU on HSI first when
+ * SYSCLK comes from that TCXO, then program the regulator before using HSE.
+ */
+static bool stm32wl_cpu_clock_is_tcxo( void )
+{
+    uint32_t source = LL_RCC_GetSysClkSource( );
+
+    if( LL_RCC_HSE_IsEnabledTcxo( ) == 0U )
+    {
+        return false;
+    }
+    return source == LL_RCC_SYS_CLKSOURCE_STATUS_HSE || source == LL_RCC_SYS_CLKSOURCE_STATUS_PLL;
+}
+
+static bool stm32wl_wait_until( uint32_t ( *flag )( void ), uint32_t expected )
+{
+    for( uint32_t i = 0U; i < 1000000U; i++ )
+    {
+        if( flag( ) == expected )
+        {
+            return true;
+        }
+    }
+    return false;
+}
+
+static void stm32wl_park_on_hsi( void )
+{
+    LL_RCC_HSI_Enable( );
+    ( void ) stm32wl_wait_until( LL_RCC_HSI_IsReady, 1U );
+    LL_RCC_SetSysClkSource( LL_RCC_SYS_CLKSOURCE_HSI );
+    ( void ) stm32wl_wait_until( LL_RCC_GetSysClkSource, LL_RCC_SYS_CLKSOURCE_STATUS_HSI );
+    LL_RCC_PLL_Disable( );
+    ( void ) stm32wl_wait_until( LL_RCC_PLL_IsReady, 0U );
+}
+
+static void stm32wl_restore_hse_pll( void )
+{
+    LL_RCC_HSE_Disable( );
+    ( void ) stm32wl_wait_until( LL_RCC_HSE_IsReady, 0U );
+    LL_RCC_HSE_EnableTcxo( );
+    LL_RCC_HSE_Enable( );
+    if( !stm32wl_wait_until( LL_RCC_HSE_IsReady, 1U ) )
+    {
+        LOG_ERR( "HSE TCXO did not restart after radio reset" );
+        return;
+    }
+    LL_RCC_PLL_Enable( );
+    if( !stm32wl_wait_until( LL_RCC_PLL_IsReady, 1U ) )
+    {
+        LOG_ERR( "PLL did not lock after radio reset" );
+        return;
+    }
+    LL_RCC_SetSysClkSource( LL_RCC_SYS_CLKSOURCE_PLL );
+    ( void ) stm32wl_wait_until( LL_RCC_GetSysClkSource, LL_RCC_SYS_CLKSOURCE_STATUS_PLL );
+}
