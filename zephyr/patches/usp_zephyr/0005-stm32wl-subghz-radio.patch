+static void sx126x_hal_set_rf_path( const struct sx126x_hal_context_cfg_t* config, uint8_t opcode )
+{
+    bool tx;
+    bool rx;
+    bool idle;
+
+    if( !config->tx_enable.port && !config->rx_enable.port )
+    {
+        return;
+    }
+
+    tx   = ( opcode == SX126X_CMD_SET_TX ) || ( opcode == SX126X_CMD_SET_TX_CONTINUOUS_WAVE ) ||
+         ( opcode == SX126X_CMD_SET_TX_INFINITE_PREAMBLE );
+    rx   = ( opcode == SX126X_CMD_SET_RX ) || ( opcode == SX126X_CMD_SET_RX_DUTY_CYCLE ) ||
+         ( opcode == SX126X_CMD_SET_CAD );
+    idle = ( opcode == SX126X_CMD_SET_STANDBY ) || ( opcode == SX126X_CMD_SET_SLEEP ) ||
+           ( opcode == SX126X_CMD_SET_FS );
+
+    if( tx )
+    {
+        if( config->rx_enable.port )
+        {
+            gpio_pin_set_dt( &config->rx_enable, 0 );
+        }
+        if( config->tx_enable.port )
+        {
+            gpio_pin_set_dt( &config->tx_enable, 1 );
+        }
+    }
+    else if( rx )
+    {
+        if( config->tx_enable.port )
+        {
+            gpio_pin_set_dt( &config->tx_enable, 0 );
+        }
+        if( config->rx_enable.port )
+        {
+            gpio_pin_set_dt( &config->rx_enable, 1 );
+        }
+    }
+    else if( idle )
+    {
+        if( config->tx_enable.port )
+        {
+            gpio_pin_set_dt( &config->tx_enable, 0 );
+        }
+        if( config->rx_enable.port )
+        {
+            gpio_pin_set_dt( &config->rx_enable, 0 );
+        }
+    }
+}
