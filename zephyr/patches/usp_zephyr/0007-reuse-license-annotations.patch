+version = 1
+
+# Semtech sources carry the Clear BSD license text without SPDX tags, and
+# build and devicetree files carry no header. These annotations let
+# REUSE-based tools such as west spdx attribute them.
+[[annotations]]
+path = "**"
+precedence = "closest"
+SPDX-FileCopyrightText = "Copyright Semtech Corporation"
+SPDX-License-Identifier = "BSD-3-Clause-Clear"
