# SPDX-License-Identifier: Apache-2.0

config RZI_LORAWAN
	bool "RZI LoRaWAN service"
	depends on FLASH
	help
	  Enable the backend-independent RZI LoRaWAN service API.

if RZI_LORAWAN

choice RZI_LORAWAN_BACKEND
	prompt "LoRaWAN backend"
	default RZI_LORAWAN_BACKEND_USP

config RZI_LORAWAN_BACKEND_USP
	bool "Semtech USP and LoRa Basics Modem"
	select LORA_BASICS_MODEM_DRIVERS
	select USP
	select USP_LORA_BASICS_MODEM
	select USP_MAIN_THREAD
	select USP_THREADS_MUTEXES
	help
	  Use the Semtech USP and LoRa Basics Modem implementation. RZI owns
	  the modem; applications must not call Semtech APIs directly. Keep
	  CONFIG_LORA=n and CONFIG_LORAWAN=n so Zephyr does not drive the
	  same radio. Do not depend on !LORA here: this choice also has a
	  Zephyr option that selects LORA, and kconfiglib recurses.

config RZI_LORAWAN_BACKEND_ZEPHYR
	bool "Zephyr LoRaWAN API"
	select LORA
	select LORAWAN
	help
	  Use Zephyr's public <zephyr/lorawan/lorawan.h> stack. The LoRa
	  module backend must be loramac-node; set
	  CONFIG_LORA_MODULE_BACKEND_LORAMAC_NODE=y. Native and LoRa Basics
	  Modem radio backends are not supported. RZI owns the stack;
	  applications must not call lorawan_* APIs directly. This is not
	  the planned Zephyr LBM LoRaWAN backend.

config RZI_LORAWAN_BACKEND_TEST
	bool "In-process test backend"
	depends on ZTEST
	help
	  Select a backend supplied by a RZI unit-test application. Do not use
	  this option in production firmware.

endchoice

if RZI_LORAWAN_BACKEND_ZEPHYR

config RZI_LORAWAN_ZEPHYR_WORKER_STACK_SIZE
	int "Zephyr backend worker stack size"
	range 1024 8192
	default 2048
	help
	  Stack for the thread that runs blocking Zephyr lorawan_join()
	  and lorawan_send() calls.

config RZI_LORAWAN_ZEPHYR_WORKER_PRIORITY
	int "Zephyr backend worker preemptive priority"
	range 0 15
	default 11

endif

config RZI_LORAWAN_EVENT_QUEUE_SIZE
	int "LoRaWAN event queue depth"
	range 4 64
	default 8

config RZI_LORAWAN_MAX_CALLBACKS
	int "Maximum LoRaWAN callback subscribers"
	range 1 16
	default 4

config RZI_LORAWAN_DISPATCHER_STACK_SIZE
	int "LoRaWAN callback dispatcher stack size"
	range 1024 8192
	default 2048

config RZI_LORAWAN_DISPATCHER_PRIORITY
	int "LoRaWAN callback dispatcher preemptive priority"
	range 0 15
	default 10

menu "Reserved LoRaWAN features"

config RZI_LORAWAN_MULTICAST
	bool "Multicast service scaffold"

config RZI_LORAWAN_LINK_CHECK
	bool "LinkCheckReq MAC command scaffold"

config RZI_LORAWAN_FUOTA
	bool "LoRaWAN FUOTA coordination"
	select LORA_BASICS_MODEM_FUOTA if RZI_LORAWAN_BACKEND_USP
	imply LORAWAN_SERVICES if RZI_LORAWAN_BACKEND_ZEPHYR
	imply LORAWAN_APP_CLOCK_SYNC if RZI_LORAWAN_BACKEND_ZEPHYR
	imply LORAWAN_FRAG_TRANSPORT if RZI_LORAWAN_BACKEND_ZEPHYR
	imply LORAWAN_REMOTE_MULTICAST if RZI_LORAWAN_BACKEND_ZEPHYR
	help
	  Enable backend-independent FUOTA coordination for ChirpStack and
	  other LoRaWAN FUOTA servers. Clock Synchronization, Remote
	  Multicast Setup and Fragmentation stay inside the selected
	  backend. RZI owns session state, image access and optional
	  MCUboot installation.

if RZI_LORAWAN_FUOTA

config RZI_FUOTA_KEEPALIVE_INTERVAL_S
	int "Unicast keepalive interval in seconds"
	range 0 86400
	default 0
	help
	  ChirpStack advances FUOTA unicast steps after the device-profile
	  expected uplink interval. Set a non-zero value to send a one-byte
	  keepalive automatically. Zero disables the timer so the
	  application can send its own periodic uplinks.

config RZI_FUOTA_KEEPALIVE_PORT
	int "Keepalive LoRaWAN port"
	range 1 223
	default 2
	depends on RZI_FUOTA_KEEPALIVE_INTERVAL_S > 0

config RZI_FUOTA_AUTO_APPLY
	bool "Apply a completed image automatically"
	depends on IMG_MANAGER
	help
	  Copy a reconstructed MCUboot image to the secondary slot and
	  reboot after a successful transfer or an FMP reboot request.

config RZI_FUOTA_HW_VERSION
	hex "Hardware version reported to FMP"
	default 0x1
	help
	  32-bit hardware version returned to the Firmware Management
	  Package. ChirpStack FUOTA does not require FMP.

endif # RZI_LORAWAN_FUOTA

config RZI_LORAWAN_DEVICE_TIME
	bool "DeviceTimeReq MAC command scaffold"

config RZI_LORAWAN_CHANNEL_SCAN
	bool "Channel-scan service scaffold"

config RZI_LORAWAN_CERTIFICATION
	bool "Certification service scaffold"

endmenu

endif # RZI_LORAWAN
