# SPDX-License-Identifier: Apache-2.0

config RZI_RSUP
	bool "RSUP (RZI Slot Update Protocol)"
	depends on RZI_MCUBOOT && RZI_MCUBOOT_DUAL_SLOT && SERIAL && FLASH && FLASH_MAP
	select REBOOT
	select CRC
	select IMG_MANAGER
	select STREAM_FLASH
	help
	  Accept RSUP on a Zephyr UART and install a signed MCUboot image
	  into slot1. The UART can be USB CDC or a hardware serial port;
	  set chosen rzi,rsup-uart. Type 0 (Arduino sketch) is not
	  handled here.

config RZI_SLOT_UPDATE
	bool
	select RZI_RSUP
	help
	  Deprecated alias for CONFIG_RZI_RSUP. Do not use in new
	  configuration files.

config RZI_USB_UPDATE
	bool
	select RZI_RSUP
	help
	  Deprecated alias for CONFIG_RZI_RSUP. Do not use in new
	  configuration files.

if RZI_RSUP

config RZI_RSUP_1200BPS
	bool "Enter update when the selected UART baud is 1200"
	depends on UART_LINE_CTRL
	default y
	help
	  Poll the bound UART. 1200 baud arms GPREGRET and resets. Works
	  on CDC and on hardware UARTs that implement line control.

config RZI_RSUP_HEADER_TIMEOUT_MS
	int "Milliseconds to wait for an RSUP header after the port is ready"
	range 1000 300000
	default 120000

endif
