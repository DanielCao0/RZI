/*
 * A board overlay replaces app.overlay, so the shared credentials
 * are included from there.
 */
#include "../app.overlay"

/* Console UART only outputs logs; disable RX to avoid starting EasyDMA RX. */
&uart20 {
	disable-rx;
};

/* Automatically suspend spi22 between SX1262 SPI transactions. */
&spi22 {
	zephyr,pm-device-runtime-auto;
};
