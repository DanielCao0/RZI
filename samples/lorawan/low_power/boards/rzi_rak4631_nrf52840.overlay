/*
 * A board overlay replaces app.overlay, so the shared credentials
 * are included from there.
 */
#include "../app.overlay"

/*
 * USB is left disabled. Enabling it requests the 32 MHz crystal for the
 * whole boot, and that request is what keeps System ON near 1 mA.
 * Console stays on uart1 from the board devicetree.
 */

/* EasyDMA SPIM suspends itself after each SX1262 transfer, so the SPI
 * block does not hold the 32 MHz clock between packets.
 *
 * The shared sleep state disconnects SCK and MOSI. Once the SX1262 is
 * awake (STDBY), those floating inputs sit between rails and the module
 * current jumps between about 0.2 mA and 4 mA. Drive the outputs low and
 * only disconnect MISO, which the radio releases in sleep.
 */
&spi1_sleep {
	group1 {
		psels = <NRF_PSEL(SPIM_SCK, 1, 11)>,
			<NRF_PSEL(SPIM_MOSI, 1, 12)>;
		/delete-property/ low-power-enable;
	};

	group2 {
		psels = <NRF_PSEL(SPIM_MISO, 1, 13)>;
		low-power-enable;
	};
};

&spi1 {
	compatible = "nordic,nrf-spim";
	zephyr,pm-device-runtime-auto;
};

&usbd {
	status = "disabled";
};

/* Module 32.768 kHz crystal on XL1/XL2. RUI3 sdk_config.h sets
 * NRF_SDH_CLOCK_LF_ACCURACY to NRF_CLOCK_LF_ACCURACY_20_PPM.
 */
&lfclk {
	k32src = "xtal";
	k32src-accuracy-ppm = <20>;
};
