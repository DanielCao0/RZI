/*
 * RAK19007 USB-UART is LPUART1 (PA2/PA3, 115200 8N1), matching RUI3.
 * The board devicetree already selects that port as the console.
 *
 * A board overlay replaces app.overlay, so the shared credentials
 * are included from there.
 */
#include "../app.overlay"
#include "stm32wl_low_power.dtsi"

/ {
	chosen {
		zephyr,console = &lpuart1;
		zephyr,shell-uart = &lpuart1;
	};
};
