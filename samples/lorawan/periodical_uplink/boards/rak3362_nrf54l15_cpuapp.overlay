/* A board overlay replaces app.overlay. */
#include "../app.overlay"

/* The sample only transmits logs; RX must not keep EasyDMA running. */
&uart20 {
	disable-rx;
	zephyr,pm-device-runtime-auto;
};

&spi22 {
	zephyr,pm-device-runtime-auto;
};
