#include "rak4631_usp_compat.dtsi"

/ {
	chosen {
		zephyr,console = &cdc_acm_uart0;
	};

	zephyr,user {
		/* Same OTAA identity as app/ (ChirpStack device RZI_001). */
		user-lorawan-device-eui = <0x74 0x85 0xef 0xc6 0x2c 0xb3 0xcb 0xd3>;
		user-lorawan-join-eui = <0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00>;
		/* GenAppKey must be non-zero for ChirpStack multicast; match AppKey. */
		user-lorawan-gen_app-key = <0x4b 0x9d 0x67 0x65 0x7d 0xa9 0xb6 0x60
					    0xf4 0xd4 0xe3 0xdd 0xf2 0xbb 0x71 0x59>;
		user-lorawan-app-key = <0x4b 0x9d 0x67 0x65 0x7d 0xa9 0xb6 0x60
					0xf4 0xd4 0xe3 0xdd 0xf2 0xbb 0x71 0x59>;
		user-lorawan-region = "EU_868";
	};
};

&zephyr_udc0 {
	cdc_acm_uart0: cdc_acm_uart0 {
		compatible = "zephyr,cdc-acm-uart";
	};
};
