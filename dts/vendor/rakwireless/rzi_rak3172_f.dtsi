/*
 * RAK3172-F WisDuo module: STM32WLE5JC (UFBGA73), 32 MHz TCXO on OSC_IN
 * supplied by PB0-VDD_TCXO, 32.768 kHz crystal, and the on-chip sub-GHz
 * radio, plus the 512 KiB Macronix SPI NOR wired inside the module on SPI2.
 * USART, I2C2, and SPI1 are configured here; the carrier enables them.
 *
 * The NOR is not brought out to the pads:
 *   PB9 CS, PB10 SCK, PC1 MOSI, PC2 MISO, PC0 WP#/SIO2, PC3 HOLD#/SIO3.
 * rzi_rak3372_f maps image-1 onto this device for overwrite FUOTA.
 * PB12 is the frequency strap. Leave it unused.
 */

#include <st/wl/stm32wle5Xc.dtsi>
#include <st/wl/stm32wle5jcix-pinctrl.dtsi>
#include <zephyr/dt-bindings/lora/sx126x.h>

/*
 * Run SYSCLK directly from MSI at 48 MHz. HSE32 is the radio reference
 * TCXO on PB0-VDD_TCXO and is controlled by the SUBGHZ radio, so STOP wake
 * never depends on restarting HSE or the PLL.
 */
&clk_hse {
	clock-frequency = <DT_FREQ_M(32)>;
	hse-tcxo;
};

&clk_msi {
	status = "okay";
	msi-range = <11>;
};

&clk_lse {
	status = "okay";
	clock-frequency = <32768>;
};

&pll {
	status = "disabled";
};

&rcc {
	clocks = <&clk_msi>;
	clock-frequency = <DT_FREQ_M(48)>;
	cpu1-prescaler = <1>;
	ahb3-prescaler = <1>;
	apb1-prescaler = <1>;
	apb2-prescaler = <1>;
};

&rng {
	clocks = <&rcc STM32_CLOCK(AHB3, 18)>,
		 <&rcc STM32_SRC_MSI RNG_SEL(3)>;
};

&subghzspi {
	status = "okay";

	lora: radio@0 {
		status = "okay";
		/* RTC66006: EN stays high in TX and RX, CTR is high for TX. */
		antenna-enable-gpios = <&gpiob 8 GPIO_ACTIVE_HIGH>;
		tx-enable-gpios = <&gpioc 13 GPIO_ACTIVE_HIGH>;
		power-amplifier-output = "rfo-hp";
		rfo-hp-max-power = <22>;
		/*
		 * On STM32WL this is SET_TCXOMODE, which sets PB0-VDD_TCXO.
		 * A radio reset clears that regulator. 3.0 V is the module default.
		 */
		dio3-tcxo-voltage = <SX126X_DIO3_TCXO_3V0>;
		tcxo-power-startup-delay-ms = <10>;
	};
};

&lptim1 {
	clocks = <&rcc STM32_CLOCK(APB1, 31)>,
		 <&rcc STM32_SRC_LSE LPTIM1_SEL(3)>;
};

&rtc {
	clocks = <&rcc STM32_CLOCK(APB1, 10)>,
		 <&rcc STM32_SRC_LSE RTC_SEL(1)>;
};

&usart1 {
	pinctrl-0 = <&usart1_tx_pb6 &usart1_rx_pb7>;
	pinctrl-names = "default";
	current-speed = <115200>;
};

&usart2 {
	pinctrl-0 = <&usart2_tx_pa2 &usart2_rx_pa3>;
	pinctrl-names = "default";
	current-speed = <115200>;
};

/* RUI3 default serial: LPUART1 on PA2/PA3. Do not enable USART2 with this. */
&lpuart1 {
	pinctrl-0 = <&lpuart1_tx_pa2 &lpuart1_rx_pa3>;
	pinctrl-names = "default";
	current-speed = <115200>;
};

&i2c2 {
	pinctrl-0 = <&i2c2_scl_pa12 &i2c2_sda_pa11>;
	pinctrl-names = "default";
	scl-gpios = <&gpioa 12 GPIO_ACTIVE_HIGH>;
	sda-gpios = <&gpioa 11 GPIO_ACTIVE_HIGH>;
	clock-frequency = <I2C_BITRATE_FAST>;
};

&spi1 {
	pinctrl-0 = <&spi1_nss_pa4 &spi1_sck_pa5
		     &spi1_miso_pa6 &spi1_mosi_pa7>;
	pinctrl-names = "default";
};

/* Internal SPI NOR. CS is GPIO so the driver can frame each command. */
&spi2 {
	pinctrl-0 = <&spi2_sck_pb10 &spi2_miso_pc2 &spi2_mosi_pc1>;
	pinctrl-names = "default";
	cs-gpios = <&gpiob 9 GPIO_ACTIVE_LOW>;
	status = "okay";

	/* Label stays ext_flash so the board partition file can reference it. */
	ext_flash: flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <8000000>;
		wp-gpios = <&gpioc 0 GPIO_ACTIVE_LOW>;
		hold-gpios = <&gpioc 3 GPIO_ACTIVE_LOW>;
		/* Binding unit is bits: 4 Mbit == 512 KiB. Observed ID: c2 23 13. */
		jedec-id = [c2 23 13];
		size = <DT_SIZE_M(4)>;
		has-dpd;
		t-enter-dpd = <10000>;
		t-exit-dpd = <35000>;
		status = "okay";
	};
};
