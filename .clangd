CompileFlags:
  CompilationDatabase: build/rzi-periodical-uplink-3372/periodical_uplink
  Add:
    - --target=arm-none-eabi
  Remove:
    - -mfp16-format=*
    - -fno-printf-return-value
    - -fdiagnostics-color=*
    - -fmacro-prefix-map=*
    - --param=*
    - -mtp=*
    - -fno-reorder-functions
    - -fno-defer-pop
