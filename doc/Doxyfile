# Doxyfile for the RZI public API and repository markdown docs.
# Generate with: scripts/generate-doxygen.sh

PROJECT_NAME           = "RZI"
PROJECT_NUMBER         = 0.2.0
PROJECT_BRIEF          = "RAK Zephyr Integration SDK"
OUTPUT_DIRECTORY       = doxygen
CREATE_SUBDIRS         = NO
OUTPUT_LANGUAGE        = English
BRIEF_MEMBER_DESC      = YES
REPEAT_BRIEF           = YES
ALWAYS_DETAILED_SEC    = NO
INLINE_INHERITED_MEMB  = NO
FULL_PATH_NAMES        = YES
STRIP_FROM_PATH        = ..
STRIP_FROM_INC_PATH    = ../include
JAVADOC_AUTOBRIEF      = NO
QT_AUTOBRIEF           = NO
MULTILINE_CPP_IS_BRIEF = NO
INHERIT_DOCS           = YES
SEPARATE_MEMBER_PAGES  = NO
TAB_SIZE               = 8
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES
BUILTIN_STL_SUPPORT    = NO
IDL_PROPERTY_SUPPORT   = YES
SUBGROUPING            = YES
LOOKUP_CACHE_SIZE      = 0

EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_PACKAGE        = NO
EXTRACT_STATIC         = NO
EXTRACT_LOCAL_CLASSES  = NO
EXTRACT_LOCAL_METHODS  = NO
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
HIDE_FRIEND_COMPOUNDS  = NO
INTERNAL_DOCS          = NO
CASE_SENSE_NAMES       = YES
HIDE_SCOPE_NAMES       = NO
SHOW_INCLUDE_FILES     = YES
SHOW_GROUPED_MEMB_INC  = YES
FORCE_LOCAL_INCLUDES   = NO
INLINE_INFO            = YES
SORT_MEMBER_DOCS       = YES
SORT_BRIEF_DOCS        = NO
SORT_GROUP_NAMES       = YES
GENERATE_TODOLIST      = NO
GENERATE_TESTLIST      = NO
GENERATE_BUGLIST       = NO
GENERATE_DEPRECATEDLIST= YES

QUIET                  = NO
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = NO
WARN_FORMAT            = "$file:$line: $text"
WARN_LOGFILE           = doxygen/warnings.log

INPUT                  = ../include/rzi \
                         README.md \
                         architecture.md \
                         boot.md \
                         power.md \
                         power-api.md \
                         west-patch.md \
                         lorawan-api.md \
                         lora-api.md \
                         lorawan-backends.md \
                         lorawan-backend-zephyr.md \
                         fuota.md \
                         storage-api.md \
                         at-framework.md \
                         at-command-compatibility.md \
                         rui3-mapping.md \
                         rui3-gap.md \
                         sbom.md \
                         ci.md \
                         coding-standards.md \
                         naming-conventions.md \
                         api-docs.md \
                         error-codes.md
FILE_PATTERNS          = *.h \
                         *.md
RECURSIVE              = YES
EXCLUDE                = doxygen \
                         reqmgmt
EXCLUDE_PATTERNS       =
EXAMPLE_PATH           =
IMAGE_PATH             =
INPUT_ENCODING         = UTF-8
USE_MDFILE_AS_MAINPAGE = README.md

CITE_BIB_FILES         =

ALPHABETICAL_INDEX     = YES
IGNORE_PREFIX          = rzi_ \
                         RZI_

ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
SEARCH_INCLUDES        = NO
INCLUDE_PATH           =
INCLUDE_FILE_PATTERNS  =
PREDEFINED             = __must_check= \
                         __deprecated= \
                         "__printf_like(x,y)=" \
                         __cplusplus
SKIP_FUNCTION_MACROS   = YES

HAVE_DOT               = NO

GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_FILE_EXTENSION    = .html
GENERATE_TREEVIEW      = YES
DISABLE_INDEX          = NO
FULL_SIDEBAR           = NO
HTML_COLORSTYLE        = LIGHT
HTML_DYNAMIC_MENUS     = YES
HTML_DYNAMIC_SECTIONS  = YES
SEARCHENGINE           = YES
SITEMAP_URL            =

GENERATE_LATEX         = NO
GENERATE_RTF           = NO
GENERATE_MAN           = NO
GENERATE_XML           = NO
GENERATE_DOCBOOK       = NO

SHOW_USED_FILES        = YES
SHOW_FILES             = YES
SHOW_NAMESPACES        = YES
FILE_VERSION_FILTER    =
LAYOUT_FILE            =
CITE_BIB_FILES         =
