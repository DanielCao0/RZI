if BOARD_RZI_RAK3372_F

# image-1 is the on-module MX25L400. CONFIG_RZI_MCUBOOT_DUAL_SLOT defaults
# y, so CONFIG_RZI_LORAWAN_FUOTA can be selected. Boot mode is overwrite.

# STOP entry suspends devices and STOP exit runs stm32_clock_control_init()
# on the idle thread. The 256-byte default overflows that path.
if PM || PM_DEVICE || PM_DEVICE_RUNTIME
config IDLE_STACK_SIZE
	default 2048
endif

config ARCH_HAS_CUSTOM_BUSY_WAIT
	default y

endif # BOARD_RZI_RAK3372_F
