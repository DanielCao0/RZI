config BOARD_RZI_RAK3362
	select SOC_NRF54L15_CPUAPP if BOARD_RZI_RAK3362_NRF54L15_CPUAPP
	select SOC_NRF54L15_CPUFLPR if BOARD_RZI_RAK3362_NRF54L15_CPUFLPR || \
					BOARD_RZI_RAK3362_NRF54L15_CPUFLPR_XIP
	select BOARD_EARLY_INIT_HOOK if PWM
	select PINCTRL_DYNAMIC if PWM
