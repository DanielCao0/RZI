# Enable Clocks
CONFIG_CLOCK_CONTROL=y

# Power Management
CONFIG_PM_DEVICE=y
CONFIG_NRFX_POWER=y

# GPIO
CONFIG_GPIO=y

# Console is uart20; the SoC has no USB device controller
CONFIG_SERIAL=y
CONFIG_CONSOLE=y
CONFIG_UART_CONSOLE=y

# Memory Protection
CONFIG_ARM_MPU=y
CONFIG_HW_STACK_PROTECTION=y
CONFIG_NULL_POINTER_EXCEPTION_DETECTION_NONE=y

# Cache
CONFIG_CACHE_MANAGEMENT=y
CONFIG_EXTERNAL_CACHE=y

# GRTC system timer
CONFIG_NRF_GRTC_START_SYSCOUNTER=y

# Regulator
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_INIT_PRIORITY=45

CONFIG_PINCTRL_KEEP_SLEEP_STATE=y
